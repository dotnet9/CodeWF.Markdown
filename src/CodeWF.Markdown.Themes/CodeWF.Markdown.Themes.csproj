<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>CodeWF.Markdown.Themes</Title>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>CodeWF.Markdown 完整包的样式入口：在 CodeWF.Markdown.Lite.Themes 的控件模板与 18 套排版主题之上，叠加图片能力控件外观。Styles entry point for the full CodeWF.Markdown package.</Description>
    <PackageId>CodeWF.Markdown.Themes</PackageId>
    <AssemblyName>CodeWF.Markdown.Themes</AssemblyName>
    <RootNamespace>CodeWF.Markdown.Themes</RootNamespace>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>avalonia ui markdown themes typography codewf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeWF.Markdown\CodeWF.Markdown.csproj" />
    <ProjectReference Include="..\CodeWF.Markdown.Lite.Themes\CodeWF.Markdown.Lite.Themes.csproj" />
  </ItemGroup>
</Project>
