<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>CodeWF.Markdown</Title>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>CodeWF.Markdown 完整包：在 CodeWF.Markdown.Lite 渲染引擎之上提供图片（GIF/SVG/预览）、数学公式、Mermaid 图表、TextMate 代码高亮、PNG/PDF/Word/公众号 HTML 导出，以及 Markdown 源码编辑器与单栏实时编辑（所见即所得）控件。Full CodeWF.Markdown package: rendering capabilities plus source and WYSIWYG editors.</Description>
    <PackageId>CodeWF.Markdown</PackageId>
    <AssemblyName>CodeWF.Markdown</AssemblyName>
    <RootNamespace>CodeWF.Markdown</RootNamespace>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>avalonia ui markdown viewer editor wysiwyg export codewf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Markdig 经 CodeWF.Markdown.Lite 传递；本包直接引用的是下面这些
         （AvaloniaEdit / AnimatedImage / CodeWF.AvaloniaControls / Lang.Avalonia.Json 来自 Lite 的传递依赖）。 -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AnimatedImage.Avalonia" />
    <PackageReference Include="CodeWF.AvaloniaControls" />
    <PackageReference Include="Lang.Avalonia.Json" />
    <PackageReference Include="Mermaider" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="Sylinko.CSharpMath.Avalonia" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeWF.Markdown.Lite\CodeWF.Markdown.Lite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\logo.png" Pack="true" PackagePath="\" Link="logo.png" />
  </ItemGroup>
</Project>
