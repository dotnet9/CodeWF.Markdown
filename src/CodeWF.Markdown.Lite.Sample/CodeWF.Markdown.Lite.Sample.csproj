<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0;net11.0-windows</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<ApplicationIcon>..\..\logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Semi.Avalonia" />
		<PackageReference Include="VC-LTL" />
		<PackageReference Include="YY-Thunks" Condition="'$(TargetFramework)' == 'net11.0-windows'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CodeWF.Markdown.Lite.Themes\CodeWF.Markdown.Lite.Themes.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
		<AvaloniaResource Include="..\..\logo.png" Link="Assets\logo.png" />
		<AvaloniaResource Include="..\..\logo.svg" Link="Assets\logo.svg" />
		<None Include="..\..\logo.png" Link="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\logo.png" />
		<None Include="..\..\logo.svg" Link="Assets\logo.svg" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\logo.svg" />
		<None Include="..\..\docs\MarkdownSamples\**\*.md" CopyToOutputDirectory="PreserveNewest">
			<Link>MarkdownSamples\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<TargetPath>MarkdownSamples\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</None>
		<None Include="..\..\docs\MarkdownStyles\**\*.txt" CopyToOutputDirectory="PreserveNewest">
			<Link>MarkdownStyles\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<TargetPath>MarkdownStyles\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</None>
	</ItemGroup>
</Project>
