<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CodeWF.Markdown.Lite.Sample.Themes.SampleTypographyThemeResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#0F766E" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#ECFDF5" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#ECFDF5" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#CCFBF1" />
            <SolidColorBrush x:Key="TextBlockCodeBackground" Color="#F1F5F9" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#5EEAD4" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#12312D" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#12312D" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#17413B" />
            <SolidColorBrush x:Key="TextBlockCodeBackground" Color="#0B1719" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="CodeWFMarkdownParagraphFontSize">17</x:Double>
    <x:Double x:Key="CodeWFMarkdownParagraphLineHeight">31</x:Double>
    <x:Double x:Key="CodeWFMarkdownHeading1FontSize">34</x:Double>
    <x:Double x:Key="CodeWFMarkdownHeading2FontSize">28</x:Double>
</ResourceDictionary>
