<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>CodeWF.Markdown.Lite</Title>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>CodeWF.Markdown 基础包：基于 Avalonia 的 Markdown 解析与渲染引擎，只渲染常规元素（标题/段落/列表/引用/表格/链接/代码块单色/图片替代文本/公式原文），不引入任何第三方能力依赖。Markdown rendering engine with no third-party capability dependencies.</Description>
    <PackageId>CodeWF.Markdown.Lite</PackageId>
    <AssemblyName>CodeWF.Markdown.Lite</AssemblyName>
    <RootNamespace>CodeWF.Markdown</RootNamespace>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>avalonia ui markdown viewer controls codewf lite</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <Compile Include="..\CodeWF.Markdown.Shared\Rendering\*.cs" Link="Rendering\Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CodeWF.AvaloniaControls" />
    <PackageReference Include="Lang.Avalonia.Json" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="I18n\Language.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Language.tt</DependentUpon>
    </Compile>
    <None Update="I18n\Language.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Language.cs</LastGenOutput>
    </None>
    <None Remove="I18n\*.json" />
    <Content Include="I18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>I18n\CodeWF.Markdown\%(Filename)%(Extension)</TargetPath>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\I18n\CodeWF.Markdown\%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>
</Project>
