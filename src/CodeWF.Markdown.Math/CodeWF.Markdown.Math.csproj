<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Math formula rendering capability package for CodeWF.Markdown (CSharpMath based).</Description>
    <PackageTags>avalonia;markdown;math;latex;csharpmath</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Sylinko.CSharpMath.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeWF.Markdown\CodeWF.Markdown.csproj" />
  </ItemGroup>

</Project>
