<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CodeWF.Markdown.Themes.InkBlackTypographyResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#2B2D31" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#F3F4F6" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#F3F4F6" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#E5E7EB" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#E5E7EB" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#22252B" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#22252B" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#2D323A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Shared/InkBlack.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
