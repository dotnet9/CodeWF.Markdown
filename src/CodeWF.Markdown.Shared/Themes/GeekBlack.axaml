<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CodeWF.Markdown.Themes.GeekBlackTypographyResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#212122" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#EEF2F7" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#EEF2F7" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#E2E8F0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#F8FAFC" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#111827" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#111827" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#1F2937" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
