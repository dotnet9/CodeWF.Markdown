<UserControl
    x:Class="CodeWF.Markdown.Sample.Views.MarkdownEditorPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="https://codewf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:CodeWF.Markdown.Editor.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://codewf.com"
    xmlns:vm="using:CodeWF.Markdown.Sample.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid x:Name="LayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 编辑列：源码编辑器与单栏实时编辑（所见即所得）共用同一列，
             窗格头由控件自带（对应原型 .pane-head），切到「实时」时互换显示。 -->
        <Grid Grid.Column="0">
            <editor:MarkdownEditorView
                x:Name="MarkdownEditor"
                AccentKey="DemoAccent"
                ChipText="Markdown"
                CodeKey="DemoCodeBrush"
                CurrentLineBackgroundKey="DemoBgHover"
                CurrentLineBorderKey="DemoBorder"
                DangerKey="DemoDanger"
                EditorBackgroundKey="DemoBgWindow"
                EditorForegroundKey="DemoText"
                Foreground="{DynamicResource DemoText}"
                HeaderText="编辑器 · AvaloniaEdit"
                ImageKey="DemoImageBrush"
                LinkKey="DemoAccent"
                QuoteKey="DemoTextMuted"
                SeparatorKey="DemoBorder"
                WarningKey="DemoDanger" />
            <editor:MarkdownLiveEditorView
                x:Name="LiveEditor"
                ChipText="所见即所得"
                EditorBackgroundKey="DemoBgWindow"
                EditorForegroundKey="DemoText"
                HeaderText="实时编辑 · MarkdownLiveEditorView"
                IsVisible="False" />
        </Grid>

        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource DemoBorder}"
            ResizeDirection="Columns" />

        <Border Grid.Column="2">
            <Grid RowDefinitions="32,*">
                <!-- 预览窗格头（对应原型 #panePreview 的 .pane-head + .ph-right） -->
                <Border Classes="pane-head">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Classes="pane-dot" VerticalAlignment="Center" />
                            <TextBlock Classes="pane-title" Text="预览 · MarkdownViewer" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Classes="pane-info"
                            Text="{Binding PreviewThemeText}" />
                    </Grid>
                </Border>
                <ScrollViewer
                    Grid.Row="1"
                    Padding="28 32 48 0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Border MaxWidth="820" HorizontalAlignment="Center">
                        <!-- 只读渲染结果：MarkdownViewer 不接受输入，编辑一律在左侧编辑器或实时视图里进行 -->
                        <md:MarkdownViewer
                            Markdown="{Binding Markdown}"
                            TypographySize="{Binding CurrentTypographySize}"
                            TypographyTheme="{Binding CurrentTypographyTheme}" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
