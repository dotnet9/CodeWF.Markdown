<UserControl
    x:Class="CodeWF.Markdown.Sample.Views.MarkdownEditorPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="https://codewf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:CodeWF.Markdown.Editor.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://codewf.com"
    xmlns:vm="using:CodeWF.Markdown.Sample.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid x:Name="LayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 编辑列：源码编辑器与单栏实时编辑（所见即所得）共用同一列，
             窗格头由控件自带（对应原型 .pane-head），切到「实时」时互换显示。 -->
        <Grid Grid.Column="0">
            <editor:MarkdownEditorView
                x:Name="MarkdownEditor"
                EditorPadding="14 16"
                EditorFontSize="13"
                EditorLineHeight="22.1"
                AccentKey="DemoAccent"
                ChipText="Markdown"
                CodeKey="DemoCodeBrush"
                CurrentLineBackgroundKey="DemoBgHover"
                CurrentLineBorderKey="DemoBorder"
                DangerKey="DemoDanger"
                EditorBackgroundKey="DemoBgWindow"
                EditorForegroundKey="DemoText"
                Foreground="{DynamicResource DemoText}"
                HeaderText="编辑器 · AvaloniaEdit"
                ImageKey="DemoImageBrush"
                LinkKey="DemoAccent"
                QuoteKey="DemoTextMuted"
                SeparatorKey="DemoBorder"
                WarningKey="DemoDanger" />
            <editor:MarkdownLiveEditorView
                x:Name="LiveEditor"
                EditorFontSize="14"
                TableHeaderBackgroundBrush="{DynamicResource DemoAccentSoft}"
                ImageBasePath="{Binding ImageBasePath}"
                TypographyTheme="{Binding CurrentTypographyTheme}"
                TypographySize="{Binding CurrentTypographySize}"
                ChipText="所见即所得"
                EditorBackgroundKey="DemoBgWindow"
                EditorForegroundKey="DemoText"
                HeaderText="实时编辑 · MarkdownLiveEditorView"
                IsVisible="False" />
        </Grid>

        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource DemoBorder}"
            ResizeDirection="Columns" />

        <Border Grid.Column="2">
            <Grid RowDefinitions="32,*">
                <!-- 预览窗格头（对应原型 #panePreview 的 .pane-head + .ph-right） -->
                <Border Classes="pane-head">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Classes="pane-dot" VerticalAlignment="Center" />
                            <TextBlock Classes="pane-title" Text="预览 · MarkdownViewer" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Classes="pane-info"
                            Text="{Binding PreviewThemeText}" />
                    </Grid>
                </Border>
                <ScrollViewer
                    Grid.Row="1"
                    Margin="32 28 32 0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Border MaxWidth="820" Margin="0 0 0 48" HorizontalAlignment="Center">
                        <!-- 只读渲染结果：MarkdownViewer 不接受输入，编辑一律在左侧编辑器或实时视图里进行 -->
                        <md:MarkdownViewer
                            ImageBasePath="{Binding ImageBasePath}"
                            Markdown="{Binding Markdown}"
                            TypographySize="{Binding CurrentTypographySize}"
                            TypographyTheme="{Binding CurrentTypographyTheme}" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    <UserControl.Styles>
        <Style Selector="editor|MarkdownLiveEditorView Border.MdLiveQuote">
            <Setter Property="Background" Value="{DynamicResource DemoAccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoAccent}" />
            <Setter Property="Padding" Value="16 10" />
            <Setter Property="Margin" Value="0 14" />
            <Setter Property="CornerRadius" Value="0 8 8 0" />
        </Style>
        <Style Selector="Button.MdCopyButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.MdCopyButton TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Normal] Border.MdH1Border">
            <Setter Property="Margin" Value="0 8 0 20" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Normal] Border.MdH2Border">
            <Setter Property="Margin" Value="0 30 0 14" />
            <Setter Property="Padding" Value="0 0 0 8" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Normal] Border.MdH3Border">
            <Setter Property="Margin" Value="0 22 0 10" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple] Border.MdQuote">
            <Setter Property="BorderBrush" Value="{DynamicResource DemoAccent}" />
            <Setter Property="Padding" Value="16 10" />
            <Setter Property="Margin" Value="0 14" />
            <Setter Property="CornerRadius" Value="0 8 8 0" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple][TypographySize=Normal]">
            <Setter Property="ParagraphFontSize" Value="14" />
            <Setter Property="ParagraphLineHeight" Value="25.9" />
            <Setter Property="Heading1FontSize" Value="28" />
            <Setter Property="Heading2FontSize" Value="21" />
            <Setter Property="Heading3FontSize" Value="17" />
            <Setter Property="ParagraphMargin" Value="0 10" />
            <Setter Property="BlockSpacing" Value="0" />
        </Style>
        <Style Selector="md|MarkdownViewer[TypographyTheme=Simple]">
            <Setter Property="TextBrush" Value="{DynamicResource DemoText}" />
            <Setter Property="MutedTextBrush" Value="{DynamicResource DemoTextSecondary}" />
            <Setter Property="AccentBrush" Value="{DynamicResource DemoAccent}" />
            <Setter Property="QuoteBackgroundBrush" Value="{DynamicResource DemoAccentSoft}" />
            <Setter Property="TableHeaderBackgroundBrush" Value="{DynamicResource DemoAccentSoft}" />
            <Setter Property="CodeBackgroundBrush" Value="{DynamicResource DemoCodeBg}" />
            <Setter Property="BorderLineBrush" Value="{DynamicResource DemoBorderStrong}" />
        </Style>
    </UserControl.Styles>
</UserControl>
