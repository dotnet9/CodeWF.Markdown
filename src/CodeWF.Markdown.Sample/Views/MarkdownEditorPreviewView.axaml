<UserControl
    x:Class="CodeWF.Markdown.Sample.Views.MarkdownEditorPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="https://codewf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:CodeWF.Markdown.Editor.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://codewf.com"
    xmlns:vm="using:CodeWF.Markdown.Sample.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid x:Name="LayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 编辑器与 Vex 共用库控件 CodeWF.Markdown.Editor，Demo 侧只做数据同步与预览联动 -->
        <Grid Grid.Column="0" RowDefinitions="32,*">
            <Border Classes="pane-head">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="pane-dot" VerticalAlignment="Center" />
                        <TextBlock Classes="pane-title" Text="编辑器 · AvaloniaEdit" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Classes="pane-title"
                        Foreground="{DynamicResource DemoTextMuted}"
                        Text="Markdown" />
                </Grid>
            </Border>
            <editor:MarkdownEditorView
                x:Name="MarkdownEditor"
                Grid.Row="1"
                AccentKey="DemoAccent"
                CodeKey="DemoCodeBrush"
                CurrentLineBackgroundKey="DemoBgHover"
                CurrentLineBorderKey="DemoBorder"
                DangerKey="DemoDanger"
                EditorBackgroundKey="DemoBgWindow"
                EditorForegroundKey="DemoText"
                Foreground="{DynamicResource DemoText}"
                ImageKey="DemoImageBrush"
                LinkKey="DemoAccent"
                QuoteKey="DemoTextMuted"
                SeparatorKey="DemoBorder"
                WarningKey="DemoDanger" />
        </Grid>

        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource DemoBorder}"
            ResizeDirection="Columns" />

        <Border
            Grid.Column="2"
            Padding="28 32 48 0">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Border MaxWidth="820" HorizontalAlignment="Center">
                    <md:MarkdownViewer
                        Markdown="{Binding Markdown}"
                        TypographySize="{Binding CurrentTypographySize}"
                        TypographyTheme="{Binding CurrentTypographyTheme}" />
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
