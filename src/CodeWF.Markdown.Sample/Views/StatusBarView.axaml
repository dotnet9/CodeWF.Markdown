<UserControl
    x:Class="CodeWF.Markdown.Sample.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodeWF.Markdown.Sample.ViewModels"
    x:DataType="vm:MainWindowViewModel">
    <!-- 状态栏分区（原型 .statusbar 30px）：左集为状态与统计，右集为版本与仓库链接
         （对应原型里 .sp 撑开后右对齐的版本徽章与 GitHub 链接）。 -->
    <Border Classes="statusbar">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <Ellipse Classes="status-ok" ToolTip.Tip="文档无未保存更改" />
                <TextBlock Text="{Binding StatusMessage}" />
                <TextBlock Text="{Binding SampleName, StringFormat='示例：{0}'}" />
                <TextBlock Text="{Binding WordCount, StringFormat='字数 {0}'}" />
                <TextBlock Text="{Binding ParseMilliseconds, StringFormat='解析 {0} ms'}" />
                <TextBlock Text="渲染：增量" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="20">
                <TextBlock Text="{Binding VersionText, StringFormat='CodeWF.Markdown {0}'}" />
                <Button
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="GitHubClick"
                    Content="去 GitHub"
                    Cursor="Hand"
                    Foreground="{DynamicResource SemiColorText2}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
