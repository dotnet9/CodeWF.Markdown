<UserControl
    x:Class="CodeWF.Markdown.Sample.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodeWF.Markdown.Sample.ViewModels"
    x:DataType="vm:MainWindowViewModel">
    <!-- 状态栏分区（原型 .statusbar 30px）：保存状态、示例名、字数、解析耗时、渲染模式、版本与仓库链接 -->
    <Border Classes="statusbar">
        <StackPanel Orientation="Horizontal" Spacing="20">
            <Ellipse Classes="status-ok" ToolTip.Tip="文档无未保存更改" />
            <TextBlock Text="{Binding StatusMessage}" />
            <TextBlock Text="{Binding SampleName, StringFormat='示例：{0}'}" />
            <TextBlock Text="{Binding WordCount, StringFormat='字数 {0}'}" />
            <TextBlock Text="{Binding ParseMilliseconds, StringFormat='解析 {0} ms'}" />
            <TextBlock Text="渲染：增量" />
            <Panel Width="20" />
            <TextBlock Text="{Binding VersionText, StringFormat='CodeWF.Markdown {0}'}" />
            <Button
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="GitHubClick"
                Content="去 GitHub"
                Cursor="Hand"
                Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
    </Border>
</UserControl>