<Window
    x:Class="CodeWF.Markdown.Sample.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="https://codewf.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:CodeWF.Markdown"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://codewf.com"
    xmlns:sample="using:CodeWF.Markdown.Sample"
    xmlns:views="using:CodeWF.Markdown.Sample.Views"
    xmlns:vm="using:CodeWF.Markdown.Sample.ViewModels"
    Title="{c:I18n {x:Static l:SampleL.WindowTitle}}"
    Width="1400"
    Height="900"
    MinWidth="980"
    MinHeight="640"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/logo.ico"
    Background="{DynamicResource DemoBgWindow}"
    WindowStartupLocation="CenterScreen"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    WindowDecorations="BorderOnly"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="LanguageSelectionTemplate" x:DataType="sample:SampleLanguage">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                <TextBlock Foreground="{DynamicResource SemiColorText2}" Text="{Binding DisplayTag}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- 窗口级样式见 Themes/ShellStyles.axaml（从本文件抽出，避免单文件继续膨胀） -->
        <StyleInclude Source="avares://CodeWF.Markdown.Sample/Themes/ShellStyles.axaml" />
    </Window.Styles>

    <!-- 下边距 -30：ExtendClientArea 窗口在 Windows 上会把 30px 状态栏高度重复计入窗口高度，
         补偿后内容正好落在窗口底边，不会在状态栏下再留一条空白。 -->
    <Grid Margin="0 0 0 -30" RowDefinitions="44,*,30">
        <!-- ① 自定义标题栏 -->
        <Border
            Grid.Row="0"
            Classes="titlebar"
            DoubleTapped="TitleBar_DoubleTapped"
            PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel
                    Grid.Column="0"
                    Margin="12 0 0 0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border Classes="brand-logo">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="M" />
                    </Border>
                    <TextBlock Classes="brand-name" Text="CodeWF.Markdown" />
                    <Border Classes="badge-demo">
                        <TextBlock FontWeight="SemiBold" Text="Demo" />
                    </Border>
                    <Border Classes="badge-version">
                        <TextBlock Text="{Binding VersionText}" />
                    </Border>
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Classes="tb-doc"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding SampleName}" />
                </Border>
                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <ComboBox
                        MinWidth="110"
                        Height="28"
                        ItemTemplate="{StaticResource LanguageSelectionTemplate}"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectLanguage, Mode=TwoWay}"
                        SelectionBoxItemTemplate="{StaticResource LanguageSelectionTemplate}" />
                    <Button
                        Classes="icon-btn"
                        Command="{Binding ToggleDarkThemeCommand}"
                        ToolTip.Tip="明暗切换">
                        <TextBlock Text="🌙" />
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Column="4"
                    Margin="0 0 6 0"
                    Orientation="Horizontal"
                    Spacing="0"
                    VerticalAlignment="Stretch">
                    <Button Classes="win-btn" Click="MinimizeClick" ToolTip.Tip="最小化">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M0 5h10"
                            Stroke="{DynamicResource SemiColorText2}"
                            StrokeThickness="1.2" />
                    </Button>
                    <Button Classes="win-btn" Click="MaximizeClick" ToolTip.Tip="最大化 / 还原">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M0.6 0.6h8.8v8.8H0.6z"
                            Stroke="{DynamicResource SemiColorText2}"
                            StrokeThickness="1.2" />
                    </Button>
                    <Button Classes="win-btn close" Click="CloseClick" ToolTip.Tip="关闭">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M1 1l8 8M9 1l-8 8"
                            Stroke="{DynamicResource SemiColorText2}"
                            StrokeThickness="1.2"
                            StrokeLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：侧栏 + 内容列 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- ② 侧栏 -->
            <Border
                x:Name="SidebarBorder"
                Grid.Column="0"
                Classes="sidebar">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        Grid.Row="0"
                        Classes="side-label"
                        Text="示例文档" />
                    <ListBox
                        Grid.Row="1"
                        Classes="doc-list"
                        ItemsSource="{Binding MarkdownFiles}"
                        SelectedItem="{Binding SelectedFile}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MarkdownSampleFile">
                                <Grid ColumnDefinitions="3,*">
                                    <Border
                                        x:Name="ActiveBar"
                                        Width="3"
                                        Margin="0 9 0 9"
                                        Background="{DynamicResource SemiColorPrimary}"
                                        CornerRadius="0 3 3 0"
                                        IsVisible="False" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="7 0 0 0"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                    <Border
                                        Width="30"
                                        Height="30"
                                        CornerRadius="7"
                                        Background="{DynamicResource SemiColorBg0}"
                                        BorderBrush="{DynamicResource SemiColorBorder}"
                                        BorderThickness="1">
                                        <Path
                                            Width="15"
                                            Height="15"
                                            Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6"
                                            Stroke="{DynamicResource SemiColorText2}"
                                            StrokeThickness="1.6"
                                            StrokeLineCap="Round"
                                            StrokeJoin="Round" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            Classes="doc-name"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Classes="doc-desc"
                                            FontSize="11"
                                            Foreground="{DynamicResource SemiColorText2}"
                                            Text="{Binding Description}" />
                                    </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 折叠侧栏按钮按用户要求移除（原型与实现同时去掉，避免做不精细的控件） -->
                </Grid>
            </Border>

            <!-- 内容列 -->
            <Grid Grid.Column="1" RowDefinitions="44,*,30">
                <!-- ③ 工具栏 -->
                <!-- ③ 工具栏（对应原型 .toolbar：三段视图切换 + 排版主题 + 字号 + 性能演示 + 导出） -->
                <Border Grid.Row="0" Classes="toolbar">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border x:Name="ViewSegment" Classes="segment">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Classes="seg"
                                    Click="ViewModeButton_Click"
                                    Tag="edit">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"
                                            Stretch="Uniform"
                                            Stroke="{DynamicResource DemoTextSecondary}"
                                            StrokeLineCap="Round"
                                            StrokeThickness="2" />
                                        <TextBlock Text="编辑" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Classes="seg on"
                                    Click="ViewModeButton_Click"
                                    Tag="split">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="M3 3h18v18H3z M12 3v18"
                                            Stretch="Uniform"
                                            Stroke="{DynamicResource DemoAccent}"
                                            StrokeThickness="2" />
                                        <TextBlock Text="分栏" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Classes="seg"
                                    Click="ViewModeButton_Click"
                                    Tag="live"
                                    ToolTip.Tip="单栏实时编辑：输入 Markdown 即时渲染">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z M4 12h6"
                                            Stretch="Uniform"
                                            Stroke="{DynamicResource DemoTextSecondary}"
                                            StrokeLineCap="Round"
                                            StrokeThickness="2" />
                                        <TextBlock Text="实时" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Classes="seg"
                                    Click="ViewModeButton_Click"
                                    Tag="preview">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="M3 3h18v18H3z M3 12h18"
                                            Stretch="Uniform"
                                            Stroke="{DynamicResource DemoTextSecondary}"
                                            StrokeThickness="2" />
                                        <TextBlock Text="预览" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Classes="group-label"
                            VerticalAlignment="Center"
                            Text="排版主题" />
                        <ComboBox
                            x:Name="TypographyThemeSelect"
                            MinWidth="170"
                            Height="30"
                            ItemsSource="{Binding TypographyThemes}"
                            SelectedItem="{Binding SelectedTypographyTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TypographyThemeChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Classes="group-label"
                            VerticalAlignment="Center"
                            Text="字号" />
                        <ComboBox
                            x:Name="FontSizeSelect"
                            MinWidth="90"
                            Height="30"
                            SelectedIndex="0"
                            SelectionChanged="FontSizeSelect_SelectionChanged">
                            <ComboBoxItem Content="标准" />
                            <ComboBoxItem Content="紧凑" />
                        </ComboBox>
                        <Panel Margin="6 0 0 0" />
                        <DropDownButton VerticalContentAlignment="Center">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource DemoTextSecondary}"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock Text="性能演示 ▾" VerticalAlignment="Center" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="增量替换压力 Ctrl+1" />
                                    <MenuItem Header="中部插入演示 Ctrl+2" />
                                    <MenuItem Header="尾部追加演示 Ctrl+3" />
                                    <Separator />
                                    <MenuItem Command="{Binding ToggleIncrementalStressCommand}" Header="停止演示" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton VerticalContentAlignment="Center">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3"
                                        Stretch="Uniform"
                                        Stroke="{DynamicResource DemoTextSecondary}"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock Text="导出 ▾" VerticalAlignment="Center" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Command="{Binding ExportPngCommand}"
                                        CommandParameter="png"
                                        Header="导出 PNG 图片" />
                                    <MenuItem
                                        Command="{Binding ExportPdfCommand}"
                                        CommandParameter="pdf"
                                        Header="导出 PDF 文档" />
                                    <MenuItem
                                        Command="{Binding ExportWordCommand}"
                                        CommandParameter="word"
                                        Header="导出 Word 文档" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding CopySocialHtmlCommand}"
                                        CommandParameter="wechat"
                                        Header="复制为公众号 HTML" />
                                    <MenuItem
                                        Command="{Binding CopySocialHtmlCommand}"
                                        CommandParameter="zhihu"
                                        Header="复制为知乎 HTML" />
                                    <MenuItem
                                        Command="{Binding CopySocialHtmlCommand}"
                                        CommandParameter="juejin"
                                        Header="复制为掘金 HTML" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <!-- 编辑 / 分栏 / 实时 / 预览 四种模式都由该视图自己按 ViewMode 切换列宽与显示，
                         此处不要再绑 IsEditorVisible，否则选「预览」会把预览列一起隐藏掉。 -->
                    <views:MarkdownEditorPreviewView
                        x:Name="EditorPreview"
                        ViewMode="{Binding ViewMode}" />
                </Grid>

                <!-- ⑥ 状态栏 -->
                <views:StatusBarView Grid.Row="2" />
            </Grid>
        </Grid>

        <!-- Quick Open 浮层 (Ctrl+P) -->
        <Border
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding IsQuickOpenVisible}"
            Background="#66000000"
            ZIndex="200">
            <Panel>
                <Border
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    MaxWidth="480" MaxHeight="380"
                    Margin="0 80 0 0"
                    CornerRadius="10"
                    Background="{DynamicResource SemiColorBg0}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    BoxShadow="0 12 32 0 #20101828">
                    <StackPanel>
                        <TextBox
                            x:Name="QuickOpenInput"
                            KeyDown="QuickOpenInput_KeyDown"
                            Margin="12 12 12 0"
                            Watermark="搜索文件…"
                            Text="{Binding QuickOpenFilter, Mode=TwoWay}" />
                        <ListBox
                            x:Name="QuickOpenList"
                            MaxHeight="280"
                            Margin="8 8 8 8"
                            ItemsSource="{Binding FilteredFiles}"
                            SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                            DoubleTapped="QuickOpenList_DoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MarkdownSampleFile">
                                    <StackPanel Margin="4 2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="{Binding Description}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Panel>
        </Border>
    </Grid>
</Window>
