<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net11.0;net11.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Lang.Avalonia.Json" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="VC-LTL" />
    <PackageReference Include="YY-Thunks" Condition="'$(TargetFramework)' == 'net11.0-windows'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeWF.Markdown.Themes\CodeWF.Markdown.Themes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
    <AvaloniaResource Include="..\..\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\logo.svg" Link="Assets\logo.svg" />
    <None Include="..\..\logo.png" Link="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\logo.png" />
    <None Include="..\..\logo.svg" Link="Assets\logo.svg" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\logo.svg" />
    <None Include="..\..\docs\MarkdownSamples\**\*.md" CopyToOutputDirectory="PreserveNewest">
      <Link>MarkdownSamples\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>MarkdownSamples\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
    <None Include="..\..\docs\MarkdownStyles\**\*.txt" CopyToOutputDirectory="PreserveNewest">
      <Link>MarkdownStyles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>MarkdownStyles\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="I18n\Language.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Language.tt</DependentUpon>
    </Compile>
    <None Update="I18n\Language.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Language.cs</LastGenOutput>
    </None>
    <None Update="I18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>I18n\CodeWF.Markdown.Sample\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>
</Project>