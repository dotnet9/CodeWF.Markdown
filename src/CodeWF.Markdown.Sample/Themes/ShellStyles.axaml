<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:codewf="https://codewf.com"
        xmlns:l="clr-namespace:Vex">
    <!-- 主窗体分区的窗口级样式（标题栏/侧栏/工具栏/面板头/状态栏），
         从 Views/MainWindow.axaml 抽出，便于分区视图与样式各自维护。 -->
        <!-- 自定义标题栏 -->
        <Style Selector="Border.titlebar">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource DemoBgTitlebar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="12 0 0 0" />
        </Style>
        <Style Selector="Border.brand-logo">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1677FF" Offset="0" />
                    <GradientStop Color="#7C3AED" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.brand-name">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DemoText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge-demo">
            <Setter Property="Padding" Value="8 1.5" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource DemoAccentSoft}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge-demo TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="Border.badge-version">
            <Setter Property="Padding" Value="8 1.5" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge-version TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <Style Selector="Border.tb-doc">
            <Setter Property="Margin" Value="14 0 0 0" />
            <Setter Property="Padding" Value="14 0 0 0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="1 0 0 0" />
        </Style>
        <Style Selector="Border.tb-doc TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>

        <!-- 窗控键 -->
        <Style Selector="Button.win-btn">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.win-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DemoBgHover}" />
        </Style>
        <Style Selector="Button.win-btn.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DemoDanger}" />
        </Style>
        <Style Selector="Button.win-btn.close:pointerover Path">
            <Setter Property="Stroke" Value="White" />
        </Style>

        <!-- 标题栏右侧控件（对应原型 .titlebar select / .icon-btn） -->
        <Style Selector="Border.titlebar ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0 6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{DynamicResource DemoBgWindow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.icon-btn">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DemoBgHover}" />
        </Style>

        <!-- 侧栏 -->
        <Style Selector="Border.sidebar">
            <Setter Property="Width" Value="216" />
            <Setter Property="Background" Value="{DynamicResource DemoBgSidebar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
        </Style>
        <!-- 选中态主色左条（对应原型 .doc-item.active::before） -->
        <Style Selector="Border.active-bar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.doc-list">
            <Setter Property="Padding" Value="8 0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.doc-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0 0 0 2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Theme">
                <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </Setter>
        </Style>
        <Style Selector="ListBox.doc-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource DemoBgHover}" />
        </Style>
        <Style Selector="ListBox.doc-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource DemoBgActive}" />
        </Style>
        <Style Selector="Border.doc-icon">
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
        </Style>
        <Style Selector="Border.doc-icon Path">
            <Setter Property="Stroke" Value="{DynamicResource DemoTextSecondary}" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="ListBox.doc-list ListBoxItem:selected Border.doc-icon">
            <Setter Property="BorderBrush" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="ListBox.doc-list ListBoxItem:selected Border.doc-icon Path">
            <Setter Property="Stroke" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="ListBox.doc-list ListBoxItem:selected Border#ActiveBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.sidebar.collapsed">
            <Setter Property="Width" Value="56" />
        </Style>
        <Style Selector="Border.sidebar TextBlock.side-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
            <Setter Property="Margin" Value="18 14 0 8" />
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.side-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.doc-name">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.doc-desc">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar.collapsed ListBoxItem">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4 10" />
        </Style>
        <Style Selector="Border.sidebar.collapsed Path.collapse-arrow">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="180" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.fb-text">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar-foot">
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
        </Style>

        <!-- 工具栏 -->
        <Style Selector="Border.toolbar">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource DemoBgToolbar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="12 0" />
        </Style>
        <Style Selector="Border.toolbar > DockPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.toolbar ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8 0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
        </Style>
        <Style Selector="ComboBox#TypographyThemeSelect">
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style Selector="ComboBox#FontSizeSelect">
            <Setter Property="MinWidth" Value="72" />
        </Style>
        <Style Selector="Window.compact Border.toolbar TextBlock.group-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.compact Button.seg">
            <Setter Property="Padding" Value="8 0" />
        </Style>
        <Style Selector="Window.compact ComboBox#TypographyThemeSelect">
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="Border.toolbar DropDownButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12 0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource DemoBgWindow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextSecondary}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Border.segment">
            <Setter Property="Background" Value="{DynamicResource DemoBgHover}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14 0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <Style Selector="Button.seg TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <Style Selector="Button.seg Path">
            <Setter Property="Stroke" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <Style Selector="Button.seg.on">
            <Setter Property="Background" Value="{DynamicResource DemoBgWindow}" />
            <Setter Property="Foreground" Value="{DynamicResource DemoAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.fmt-btn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.fmt-btn:hover">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="TextBlock.group-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText3}" />
        </Style>

        <!-- 面板头（对应原型 .pane-head：高 32、内边距 0 12、11px 粗体字距 .8、次级色） -->
        <Style Selector="Border.pane-head">
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="12 0" />
        </Style>
        <Style Selector="Button.seg.on TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="Button.seg.on Path">
            <Setter Property="Stroke" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DemoBgWindow}" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #1F101828" />
        </Style>
        <Style Selector="Border.pane-head > Grid">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pane-head StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pane-head Path.stroke-ico">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Data" Value="M3 0 A3 3 0 1 0 3 6 A3 3 0 1 0 3 0" />
            <Setter Property="Fill" Value="{DynamicResource DemoAccent}" />
            <Setter Property="StrokeThickness" Value="0" />
        </Style>
        <Style Selector="Border.kbd-chip">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.kbd-chip > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <Style Selector="TextBlock.doc-name">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DemoText}" />
        </Style>
        <Style Selector="TextBlock.doc-desc">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <Style Selector="Ellipse.pane-dot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="TextBlock.pane-title">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <!-- 面板头右侧信息（对应原型 .ph-right：常规字重、无字距） -->
        <Style Selector="TextBlock.pane-info">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>

        <!-- 状态栏（对应原型 .statusbar：高 30、gap 20、内边距 0 16、字号 12、顶部 1px 描边） -->
        <Style Selector="Border.statusbar">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource DemoBgSidebar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="Padding" Value="16 0" />
        </Style>
        <Style Selector="Border.statusbar TextBlock.status-text">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.status-ok">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource DemoSuccess}" />
        </Style>
        <!-- 状态栏链接（对应原型 .statusbar a：默认次级色，悬停主色） -->
        <Style Selector="Button.status-link">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.status-link:pointerover TextBlock.status-text">
            <Setter Property="Foreground" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="Button.status-link:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource DemoAccent}" />
        </Style>
</Styles>
