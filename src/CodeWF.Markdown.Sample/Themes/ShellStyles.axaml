<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:codewf="https://codewf.com"
        xmlns:l="clr-namespace:Vex">
    <!-- 主窗体分区的窗口级样式（标题栏/侧栏/工具栏/面板头/状态栏），
         从 Views/MainWindow.axaml 抽出，便于分区视图与样式各自维护。 -->
        <!-- 自定义标题栏 -->
        <Style Selector="Border.titlebar">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource DemoBgTitlebar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="12 0 0 0" />
        </Style>
        <Style Selector="Border.brand-logo">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1677FF" Offset="0" />
                    <GradientStop Color="#7C3AED" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.brand-name">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style Selector="Border.badge-demo">
            <Setter Property="Padding" Value="8 2" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource DemoAccentSoft}" />
        </Style>
        <Style Selector="Border.badge-demo TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="Border.badge-version">
            <Setter Property="Padding" Value="8 2" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.badge-version TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>
        <Style Selector="Border.tb-doc">
            <Setter Property="Margin" Value="14 0 0 0" />
            <Setter Property="Padding" Value="14 0 0 0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="1 0 0 0" />
        </Style>
        <Style Selector="Border.tb-doc TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource DemoTextMuted}" />
        </Style>

        <!-- 窗控键 -->
        <Style Selector="Button.win-btn">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.win-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DemoBgHover}" />
        </Style>
        <Style Selector="Button.win-btn.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E5484D" />
        </Style>
        <Style Selector="Button.win-btn.close:pointerover Path">
            <Setter Property="Stroke" Value="White" />
        </Style>

        <!-- 侧栏 -->
        <Style Selector="Border.sidebar">
            <Setter Property="Width" Value="216" />
            <Setter Property="Background" Value="{DynamicResource DemoBgSidebar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
        </Style>
        <!-- 选中态主色左条（对应原型 .doc-item.active::before） -->
        <Style Selector="ListBox.doc-list ListBoxItem:selected Border#ActiveBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.sidebar.collapsed">
            <Setter Property="Width" Value="56" />
        </Style>
        <Style Selector="Border.sidebar TextBlock.side-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText3}" />
            <Setter Property="Margin" Value="16 14 0 8" />
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.side-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.doc-name">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.doc-desc">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar.collapsed ListBoxItem">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4 10" />
        </Style>
        <Style Selector="Border.sidebar.collapsed Path.collapse-arrow">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="180" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.sidebar.collapsed TextBlock.fb-text">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sidebar-foot">
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
        </Style>

        <!-- 工具栏 -->
        <Style Selector="Border.toolbar">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource DemoBgToolbar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="12 0" />
        </Style>
        <Style Selector="Border.segment">
            <Setter Property="Background" Value="{DynamicResource DemoBgHover}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14 0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
        <Style Selector="Button.seg.on">
            <Setter Property="Background" Value="{DynamicResource DemoBgWindow}" />
            <Setter Property="Foreground" Value="{DynamicResource DemoAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.fmt-btn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.fmt-btn:hover">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="TextBlock.group-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText3}" />
        </Style>

        <!-- 面板头 -->
        <Style Selector="Border.pane-head">
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="12 0" />
        </Style>
        <Style Selector="Ellipse.pane-dot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource DemoAccent}" />
        </Style>
        <Style Selector="TextBlock.pane-title">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText3}" />
        </Style>

        <!-- 状态栏 -->
        <Style Selector="Border.statusbar">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource DemoBgSidebar}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DemoBorder}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="Padding" Value="16 0" />
        </Style>
        <Style Selector="Ellipse.status-ok">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource SemiColorSuccess}" />
        </Style>
    
</Styles>
