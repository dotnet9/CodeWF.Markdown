<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>CodeWF.Markdown.Lite.Themes</Title>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>CodeWF.Markdown.Lite 的控件模板与 18 套排版主题（公众号/技术文档风格，适配 Avalonia 明暗变体），不含图片/公式等能力相关外观。Control templates and typography themes for CodeWF.Markdown.Lite.</Description>
    <PackageId>CodeWF.Markdown.Lite.Themes</PackageId>
    <AssemblyName>CodeWF.Markdown.Lite.Themes</AssemblyName>
    <RootNamespace>CodeWF.Markdown.Themes</RootNamespace>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>avalonia ui markdown themes typography codewf lite</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeWF.Markdown.Lite\CodeWF.Markdown.Lite.csproj" />
  </ItemGroup>
</Project>
