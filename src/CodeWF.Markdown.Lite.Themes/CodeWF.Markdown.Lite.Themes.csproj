<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>CodeWF.Markdown.Lite.Themes</Title>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>Typography themes and default control template for CodeWF.Markdown.Lite.</Description>
    <PackageId>CodeWF.Markdown.Lite.Themes</PackageId>
    <AssemblyName>CodeWF.Markdown.Lite.Themes</AssemblyName>
    <RootNamespace>CodeWF.Markdown.Lite.Themes</RootNamespace>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>avalonia ui markdown themes typography lite codewf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeWF.Markdown.Lite\CodeWF.Markdown.Lite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CodeWF.Markdown.Shared\Themes\*.cs" Link="%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\CodeWF.Markdown.Shared\Themes\**\*.axaml" Link="Themes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>