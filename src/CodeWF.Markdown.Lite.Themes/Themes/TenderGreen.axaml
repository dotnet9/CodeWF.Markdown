<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CodeWF.Markdown.Themes.TenderGreenTypographyResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#595959" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#F5F5F5" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#F5F5F5" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#E8E8E8" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#D4D4D4" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#17372F" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#17372F" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#1F4A40" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
