<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CodeWF.Markdown.Themes.FrontendPeakTypographyResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#0EA5E9" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#EFFAFF" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#EFFAFF" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#DDF4FF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#38BDF8" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#0C2E3D" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#0C2E3D" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#123F53" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Shared/FrontendPeak.axaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
