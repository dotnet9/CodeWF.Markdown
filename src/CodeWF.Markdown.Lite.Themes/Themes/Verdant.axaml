<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CodeWF.Markdown.Themes.VerdantTypographyResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#35B378" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#EEF9F0" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#EEF9F0" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#DDF4E4" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#6EE7A5" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#17351D" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#17351D" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#214A29" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
