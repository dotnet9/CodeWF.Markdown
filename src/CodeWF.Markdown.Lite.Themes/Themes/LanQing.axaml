<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CodeWF.Markdown.Themes.LanQingTypographyResources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#009688" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#EAF7F5" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#EAF7F5" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#D6EFEC" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#5EEAD4" />
            <SolidColorBrush x:Key="BorderCardBackground" Color="#12353A" />
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#12353A" />
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="#19474E" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
