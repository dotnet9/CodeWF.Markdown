<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeWF.Markdown.Lite\CodeWF.Markdown.Lite.csproj" />
    <!-- 主题类型集中在 Lite.Themes：用别名引用，避免与完整包 Themes 的同名命名空间混用。 -->
    <ProjectReference Include="..\..\src\CodeWF.Markdown.Lite.Themes\CodeWF.Markdown.Lite.Themes.csproj" Aliases="FullThemes" />
    <ProjectReference Include="..\..\src\CodeWF.Markdown\CodeWF.Markdown.csproj" />
    <ProjectReference Include="..\..\src\CodeWF.Markdown.Themes\CodeWF.Markdown.Themes.csproj" />
  </ItemGroup>
</Project>
